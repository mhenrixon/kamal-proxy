#!/bin/bash

# Release dash-proxy as ghcr.io/mhenrixon/kamal-proxy.
#
# Tags are four-segment: vX.Y.Z.N, e.g. v1.0.0.0.
#
# The shape is unchanged from when this was a fork, but the meaning is not: all
# four segments are ours to choose. They used to be <upstream-base>.<counter>,
# derived from whatever basecamp had tagged. We own dash-proxy now, so the
# number reflects what shipped here.
#
# Plain semver vX.Y.Z is accepted too, so nobody is blocked by the distinction.
# Keep this grammar and docker-publish.yml's tag filter in step -- a tag the
# filter does not match pushes silently and never builds an image.
#
# Never use suffix forms like v1.0.0-rc1: the dash gem reads the proxy version
# from the image tag and compares it with Gem::Version, which reads a hyphen
# suffix as a PRERELEASE sorting BELOW the release it names. A tag that sorts
# below itself fails the gem's MINIMUM_VERSION check.

set -e

usage() {
  echo "Usage: $0 <tag>"
  echo "  <tag>    Release tag, vX.Y.Z.N (e.g. v1.0.0.0)"
  exit 1
}

if [ $# -ne 1 ]; then
  usage
fi

TAG=$1

if ! echo "$TAG" | grep -Eq '^v[0-9]+\.[0-9]+\.[0-9]+(\.[0-9]+)?$'; then
  echo "Error: tag must be vX.Y.Z.N (e.g. v1.0.0.0), or plain vX.Y.Z"
  usage
fi

if git rev-parse -q --verify "refs/tags/${TAG}" >/dev/null; then
  echo "Error: tag ${TAG} already exists"
  exit 1
fi

make test

git tag -a "${TAG}" -m "dash-proxy ${TAG}"
git push origin "tag" "${TAG}"

echo "Tag ${TAG} pushed. CI will publish ghcr.io/mhenrixon/kamal-proxy:${TAG}"
echo "Verify with: docker buildx imagetools inspect ghcr.io/mhenrixon/kamal-proxy:${TAG}"
